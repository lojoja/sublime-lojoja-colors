{
  "folders": [
    {
      "folder_exclude_patterns": ["*.egg-info", ".ruff_cache", ".pytest_cache", "__pycache__"],
      "path": "."
    }
  ],
  "settings": {
    "LSP": {
      "LSP-pylsp": {
        "enabled": false
      },
      "LSP-ruff": {
        "enabled": true,
        "command": [".venv/bin/ruff", "server"]
      },
      "ltex-ls": {
        "settings": {
          "ltex.dictionary": {
            "en-US": ["lojoja", "lojoja-pcrepo"]
          }
        }
      }
    }
  },
  "build_systems": [
    {
      "name": "Build color schemes",
      "cmd": ["uv", "run", "build"],
      "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
      "selector": "source.json, source.python"
    },
    {
      "name": "Create color scheme configuration JSON schema",
      "cmd": ["uv", "run", "schema"],
      "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
      "selector": "source.json, source.python"
    },
    {
      "name": "Validate color schemes",
      "cmd": ["uv", "run", "validate"],
      "file_regex": "^[ ]*File \"(...*?)\", line ([0-9]*)",
      "selector": "source.json, source.python"
    }
  ]
}
